---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Confiance from '../components/Confiance.astro';
import Formules from '../components/Formules.astro';
import Services from '../components/Services.astro';
import Deroule from '../components/Deroule.astro';
import Engagements from '../components/Engagements.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

const yearsExperience = new Date().getFullYear() - 2013;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Longatte SRL',
  image: new URL('/favicon/og-tile-512.png', Astro.site).toString(),
  url: Astro.site?.toString(),
  email: 'francois@longatte.be',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Attert',
    addressCountry: 'BE',
  },
  areaServed: 'BE',
  priceRange: '€€',
};
---

<Layout
  title="Longatte — Sites vitrines sur mesure, remarquablement rapides"
  description={`Création de sites web sur mesure et abonnement d'entretien sans tracas, par un artisan unique. Belgique — ${yearsExperience} ans d'expérience.`}
>
  <TopBar />
  <main>
    <Hero />
    <Stats />
    <Confiance />
    <Formules />
    <Services />
    <Deroule />
    <Engagements />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <MobileBar />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
</Layout>
