---
// Chèques-entreprises : masqué en attendant de se renseigner sur les conditions.
const showChequesEntreprises = false;
---

<section id="formules" class="g-sec g-pad" style="padding:0 32px 120px">
  <div style="max-width:1120px;margin:0 auto">
    <div class="reveal" style="max-width:620px;display:flex;flex-direction:column;gap:18px;margin-bottom:52px">
      <span class="eyebrow">Formules</span>
      <h2 class="dsp d2" style="font-size:54px">Deux façons de travailler ensemble</h2>
      <p style="margin:0;font-size:17px;line-height:1.6;color:rgba(29,29,31,0.62)">
        Une création soignée, puis &mdash; si vous le souhaitez &mdash; une prise en charge complète dans la durée.
      </p>
    </div>

    <div class="glass reveal" style="padding:44px">
      <div class="g-cle">
        <div style="display:flex;flex-direction:column;gap:20px">
          <span style="font-size:11.5px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:rgba(29,29,31,0.5)">Création</span>
          <h3 class="dsp" style="font-size:32px">Site clé en main</h3>
          <p class="dsp" style="font-size:44px">dès 2 500 &euro;</p>
          <button type="button" class="btn-g" data-open-lead-modal style="align-self:flex-start">Demander un devis</button>
        </div>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px;font-size:15.5px;line-height:1.5;color:rgba(29,29,31,0.74)">
          <li style="display:flex;gap:14px"><span style="color:#0e9b78">&mdash;</span>Conception sur mesure, sans gabarit</li>
          <li style="display:flex;gap:14px"><span style="color:#0e9b78">&mdash;</span>Site remarquablement rapide, par conception</li>
          <li style="display:flex;gap:14px"><span style="color:#0e9b78">&mdash;</span>Textes et structure pensés pour Google</li>
          <li style="display:flex;gap:14px"><span style="color:#0e9b78">&mdash;</span>Conforme RGPD dès la mise en ligne</li>
          <li style="display:flex;gap:14px"><span style="color:#0e9b78">&mdash;</span>Vous êtes propriétaire de votre site</li>
        </ul>
      </div>
    </div>

    <div style="margin:52px 0 22px;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
      <p style="margin:0;font-size:11.5px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:rgba(29,29,31,0.65)">
        Puis, chaque mois &mdash; selon vos besoins
      </p>
      <span class="pill" style="padding:5px 13px;background:#0e9b78;color:#fff;font-size:10.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase">
        2 mois offerts par an
      </span>
    </div>
    <div class="g-plans">
      <div class="glass glass-lift reveal" style="padding:34px;display:flex;flex-direction:column;gap:16px">
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:rgba(29,29,31,0.5)">Maintenance</span>
        <h3 class="dsp" style="font-size:25px">Sérénité technique</h3>
        <p class="dsp" style="font-size:36px">Sur devis</p>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:11px;font-size:14.5px;line-height:1.5;color:rgba(29,29,31,0.7)">
          <li style="display:flex;gap:11px"><span style="color:#0e9b78">&mdash;</span>Hébergement, sécurité, sauvegardes</li>
          <li style="display:flex;gap:11px"><span style="color:#0e9b78">&mdash;</span>Mises à jour de contenu incluses</li>
          <li style="display:flex;gap:11px"><span style="color:#0e9b78">&mdash;</span>Interventions prioritaires</li>
        </ul>
      </div>

      <div class="glass glass-lift reveal" style="padding:34px;display:flex;flex-direction:column;gap:16px">
        <span style="font-size:11.5px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:rgba(29,29,31,0.5)">Réseaux sociaux</span>
        <h3 class="dsp" style="font-size:25px">Présence animée</h3>
        <p class="dsp" style="font-size:36px">Sur devis</p>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:11px;font-size:14.5px;line-height:1.5;color:rgba(29,29,31,0.7)">
          <li style="display:flex;gap:11px"><span style="color:#0e9b78">&mdash;</span>Deux publications par semaine</li>
          <li style="display:flex;gap:11px"><span style="color:#0e9b78">&mdash;</span>Visuels cohérents avec votre site</li>
          <li style="display:flex;gap:11px"><span style="color:#0e9b78">&mdash;</span>Plateformes définies ensemble</li>
        </ul>
      </div>

      <div class="glass glass-lift reveal plan-hero" style="padding:34px;display:flex;flex-direction:column;gap:16px;background:rgba(255,255,255,0.82)">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
          <span style="font-size:11.5px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:rgba(29,29,31,0.6)">Les deux</span>
          <span class="pill" style="padding:5px 13px;background:#1d1d1f;color:#fff;font-size:10.5px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase">Recommandé</span>
        </div>
        <h3 class="dsp" style="font-size:25px">Sérénité complète</h3>
        <p class="dsp" style="font-size:36px">Sur devis<span style="font-size:14px;font-weight:400;letter-spacing:0;color:rgba(29,29,31,0.55)"> &nbsp;&mdash; tarif préférentiel</span></p>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:11px;font-size:14.5px;line-height:1.5;color:rgba(29,29,31,0.78)">
          <li style="display:flex;gap:11px"><span style="color:#0e9b78">&mdash;</span>Maintenance et réseaux sociaux réunis</li>
          <li style="display:flex;gap:11px"><span style="color:#0e9b78">&mdash;</span>Une seule facture, un seul interlocuteur</li>
        </ul>
        <div style="margin-top:auto;padding-top:12px">
          <a href="mailto:francois@longatte.be" class="btn-g">Parler de votre projet</a>
        </div>
      </div>
    </div>

    <p style="margin:22px 0 0;font-size:13px;color:rgba(29,29,31,0.65)">
      Le prix de création dépend de l'ampleur du projet &mdash; vous recevez un devis ferme après un premier échange. Les abonnements sont sans
      engagement de durée, résiliables avec un mois de préavis (<a
        href="/conditions-generales"
        style="color:#1d1d1f;text-decoration:underline;text-underline-offset:3px">conditions générales</a>). En prenant l'abonnement annuel,
      vous recevez 2 mois offerts.
    </p>

    {
      showChequesEntreprises && (
        <div class="glass reveal" style="margin-top:28px;padding:22px 26px;display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;border-radius:18px">
          <span style="font-size:11.5px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:#1d1d1f;flex:none">Chèques-entreprises</span>
          <span style="font-size:14.5px;line-height:1.6;color:rgba(29,29,31,0.68)">
            Entreprise wallonne&nbsp;? Votre projet peut être partiellement financé par la Région via les
            <a href="https://www.cheques-entreprises.be" target="_blank" rel="noopener" style="color:#1d1d1f;text-decoration:underline;text-underline-offset:3px">chèques-entreprises</a>.
            On en parle lors du premier échange.
          </span>
        </div>
      )
    }
  </div>
</section>
