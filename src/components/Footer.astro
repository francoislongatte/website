---
const foundingYear = 2024;
const year = new Date().getFullYear();
const copyrightYears = year > foundingYear ? `${foundingYear}–${year}` : `${foundingYear}`;
---

<footer class="g-pad g-endpad" style="padding:0 32px 46px">
  <div class="g-footer" style="max-width:1120px;margin:0 auto;padding-top:32px;border-top:1px solid rgba(29,29,31,0.1)">
    <span class="wm" style="font-size:17px">
      L<svg width="12" height="12" viewBox="0 0 36 36" aria-hidden="true">
        <circle class="wm-track" cx="18" cy="18" r="14" fill="none" stroke-width="5.5"></circle>
        <circle class="wm-arc" cx="18" cy="18" r="14" fill="none" stroke-width="5.5" stroke-linecap="round" transform="rotate(-90 18 18)"></circle>
      </svg>NGATTE
    </span>
    <a
      href="https://www.linkedin.com/in/fran%C3%A7ois-longatte/"
      target="_blank"
      rel="noopener"
      style="font-size:13px;color:rgba(29,29,31,0.65);text-decoration:underline;text-underline-offset:3px"
    >
      LinkedIn
    </a>
    <span style="font-size:13px;color:rgba(29,29,31,0.65)">Attert, Belgique &middot; francois@longatte.be</span>
    <div style="display:flex;gap:16px">
      <a href="/mentions-legales" style="font-size:13px;color:rgba(29,29,31,0.65);text-decoration:underline;text-underline-offset:3px">
        Mentions légales
      </a>
      <a
        href="/politique-de-confidentialite"
        style="font-size:13px;color:rgba(29,29,31,0.65);text-decoration:underline;text-underline-offset:3px"
      >
        Politique de confidentialité
      </a>
    </div>
    <span style="font-size:13px;color:rgba(29,29,31,0.65)">&copy; {copyrightYears} LONGATTE SRL</span>
  </div>
</footer>
